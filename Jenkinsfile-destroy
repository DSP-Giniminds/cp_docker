pipeline {
    agent any

    environment {
        NETWORK = 'giniminds-bridge'
        PROJECT = 'cp-8'
    }

    parameters {
        string(name: 'CONFIRM', defaultValue: '', description: 'Type DESTROY to confirm full cleanup')
    }

    stages {

        stage('Safety Check') {
            steps {
                script {
                    if (params.CONFIRM != "DESTROY") {
                        error("❌ Confirmation failed. Type DESTROY to proceed with cleanup.")
                    }
                }
            }
        }

        stage('Debug') {
            steps {
                sh '''
                echo "===== WORKSPACE ====="
                pwd
                ls -la

                echo "===== ACTIVE COMPOSE PROJECTS ====="
                docker compose ls || true
                '''
            }
        }

        stage('Stop and Remove Stack') {
            steps {
                sh '''
                echo "===== DESTROYING STACK ====="

                docker compose -p ${PROJECT} -f cp.yml down -v || true
                docker compose -p ${PROJECT} -f c3.yml down -v || true
                '''
            }
        }

        stage('Remove Network') {
            steps {
                sh '''
                echo "===== REMOVING NETWORK ====="
                docker network rm ${NETWORK} || true
                '''
            }
        }

        stage('Verification') {
            steps {
                sh '''
                echo "===== VERIFY CLEANUP ====="

                echo "--- Containers ---"
                docker ps

                echo "--- Compose Projects ---"
                docker compose ls

                echo "--- Networks ---"
                docker network ls

                echo "--- Volumes ---"
                docker volume ls
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Stack destroyed successfully'
        }
        failure {
            echo '❌ Destroy failed — check logs'
        }
    }
}
